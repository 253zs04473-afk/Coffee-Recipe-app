doctype html
html(lang="ja")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title コーヒー抽出レシピ帳
    style.
      :root { --brown: #5b3a29; --cream: #faf5ee; --line: #e4d8c8; }
      body { font-family: sans-serif; max-width: 680px; margin: 0 auto; padding: 1.5rem 1rem 3rem; color: #2b211b; background: var(--cream); }
      h1 { color: var(--brown); font-size: 1.6rem; margin-bottom: .25rem; }
      h2 { color: var(--brown); font-size: 1.15rem; }
      nav { margin-bottom: 1rem; font-size: .9rem; }
      a { color: var(--brown); }
      form.recipe { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 1rem; }
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
      @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
      label { display: block; font-size: .9rem; margin-bottom: .75rem; }
      input, select, textarea { width: 100%; box-sizing: border-box; padding: .5rem; font: inherit; margin-top: .2rem; border: 1px solid #cdbfae; border-radius: 4px; background: #fff; }
      button { padding: .5rem 1.2rem; font: inherit; cursor: pointer; background: var(--brown); color: #fff; border: 0; border-radius: 4px; }
      button.danger { background: #a32121; padding: .3rem .8rem; }
      .error { color: #b00020; font-weight: bold; }
      ul.recipes { list-style: none; padding: 0; }
      ul.recipes li { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: .9rem 1rem; margin-bottom: .75rem; }
      img.photo { max-width: 100%; max-height: 220px; border-radius: 6px; margin-bottom: .5rem; display: block; }
      .title { font-weight: bold; font-size: 1.05rem; }
      .stars { color: #c9822b; letter-spacing: 2px; }
      .meta { color: #6b5a4d; font-size: .85rem; margin: .25rem 0; }
      .stats { display: flex; flex-wrap: wrap; gap: .4rem 1rem; font-size: .9rem; margin: .5rem 0; }
      .stats span b { color: var(--brown); }
      .notes { font-size: .9rem; white-space: pre-wrap; }
      .filter a { margin-right: .6rem; font-size: .9rem; }
      .filter a.active { font-weight: bold; text-decoration: none; }
  body
    block content
